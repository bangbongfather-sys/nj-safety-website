{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nj-safety-website",
  "compatibility_date": "2025-04-01",
  // Kept from when /api/contact composed MIME messages with mimetext.
  // Nothing in the Worker needs node built-ins today, but the flag is
  // harmless and dropping it changes runtime resolution behaviour, so
  // it stays until there's a reason to touch it.
  "compatibility_flags": ["nodejs_compat"],

  // Worker entry — handles /api/admin/upload-image, falls back to static
  // assets for everything else. Until we ship the upload feature this
  // Worker is essentially a passthrough.
  "main": "worker/index.ts",

  // Live domain. Declared here rather than only in the dashboard so the
  // binding is version-controlled and a fresh deploy re-asserts it.
  // `custom_domain` makes Cloudflare manage the DNS record and issue the
  // certificate; njfashion.co.kr's nameservers point at Cloudflare
  // (registrar is still 가비아). www and m are attached so the Worker can
  // 301 them onto the apex — see CANONICAL_HOST in worker/index.ts.
  // The nj-safety-website.njsafety91.workers.dev address stays live
  // alongside these as an admin fallback.
  "routes": [
    { "pattern": "njfashion.co.kr", "custom_domain": true },
    { "pattern": "www.njfashion.co.kr", "custom_domain": true },
    { "pattern": "m.njfashion.co.kr", "custom_domain": true }
  ],

  // MUST stay true. Declaring `routes` makes wrangler disable the
  // workers.dev address by default, which silently killed the admin's
  // fallback URL the first time this config shipped. That address is the
  // only way in if njfashion.co.kr ever has DNS or certificate trouble.
  "workers_dev": true,

  // Static export (`out/`) served via the ASSETS binding. The Worker
  // delegates to env.ASSETS.fetch(req) for any path it doesn't handle.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // R2 bucket for admin-uploaded images. Bucket MUST be created in the
  // Cloudflare dashboard first (Workers & Pages → R2 → Create bucket
  // → name: `nj-images`) and have Public Access enabled. Until then
  // upload requests will fail at runtime but the rest of the site
  // (static pages, text edits) keeps working.
  "r2_buckets": [
    {
      "binding": "IMAGES_R2",
      "bucket_name": "nj-images"
    }
  ],

  // NOTE — no email binding, on purpose.
  //
  // 문의 폼 submissions are stored in R2 under `inquiries/` and read
  // from /admin/inquiries. Emailing them out was tried and dropped:
  // Cloudflare's send_email binding refuses any sender whose domain
  // the account doesn't own ("email from naver.com not allowed because
  // domain is not owned by the same account"), and this account has no
  // zones with Email Routing. Reviving it would mean moving a domain
  // onto Cloudflare (or paying for a third-party mail API) — see git
  // history for the working Resend implementation if that day comes.

  // Public-facing R2 URL. After the bucket's Public Access is enabled,
  // copy the `https://pub-<hash>.r2.dev` URL from the bucket Settings
  // and replace the placeholder below (or set it via dashboard
  // Environment Variables instead — dashboard wins over wrangler.jsonc).
  "vars": {
    "R2_PUBLIC_BASE": "https://pub-586a8dd3a5484370b45c7ace72da8dc4.r2.dev",
    "ADMIN_GH_LOGIN": "bangbongfather-sys"
  },

  "observability": {
    "enabled": true
  }
}
