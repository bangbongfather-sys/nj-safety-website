{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nj-safety-website",
  "compatibility_date": "2025-04-01",
  // mimetext (used by /api/contact for MIME message composition) pulls
  // mime-types -> node 'path' / 'os'. nodejs_compat enables those built-ins
  // inside the Worker runtime; without it the build fails to resolve "path".
  "compatibility_flags": ["nodejs_compat"],

  // Worker entry — handles /api/admin/upload-image, falls back to static
  // assets for everything else. Until we ship the upload feature this
  // Worker is essentially a passthrough.
  "main": "worker/index.ts",

  // Static export (`out/`) served via the ASSETS binding. The Worker
  // delegates to env.ASSETS.fetch(req) for any path it doesn't handle.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // R2 bucket for admin-uploaded images. Bucket MUST be created in the
  // Cloudflare dashboard first (Workers & Pages → R2 → Create bucket
  // → name: `nj-images`) and have Public Access enabled. Until then
  // upload requests will fail at runtime but the rest of the site
  // (static pages, text edits) keeps working.
  "r2_buckets": [
    {
      "binding": "IMAGES_R2",
      "bucket_name": "nj-images"
    }
  ],

  // Outbound transactional email.
  //
  // PRIMARY TRANSPORT — Resend. The Worker uses it whenever the
  // RESEND_API_KEY secret exists:
  //
  //   wrangler secret put RESEND_API_KEY
  //
  // Sign the Resend account up with the address that should RECEIVE
  // the inquiries (njsafety91@naver.com). Resend's shared sandbox
  // sender (onboarding@resend.dev, the RESEND_FROM default) only
  // delivers to the account's own address; verifying a domain on
  // Resend lifts that and lets RESEND_FROM be a real @njfashion.co.kr
  // sender.
  //
  // FALLBACK — Cloudflare's own send_email binding, used only when
  // RESEND_API_KEY is unset. It CANNOT deliver today: Cloudflare
  // rejects any sender whose domain the account doesn't own
  // ("email from naver.com not allowed because domain is not owned by
  // the same account"), and this account has no zones with Email
  // Routing. Making it work needs a domain moved onto Cloudflare with
  // Email Routing enabled, plus the destination address verified
  // under Workers & Pages → nj-safety-website → Settings → Send Email.
  //
  // The binding name 'CONTACT_EMAIL' is what worker/index.ts calls —
  // keep the two in sync if you rename.
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "njsafety91@naver.com"
    }
  ],

  // Public-facing R2 URL. After the bucket's Public Access is enabled,
  // copy the `https://pub-<hash>.r2.dev` URL from the bucket Settings
  // and replace the placeholder below (or set it via dashboard
  // Environment Variables instead — dashboard wins over wrangler.jsonc).
  "vars": {
    "R2_PUBLIC_BASE": "https://pub-586a8dd3a5484370b45c7ace72da8dc4.r2.dev",
    "ADMIN_GH_LOGIN": "bangbongfather-sys"
  },

  "observability": {
    "enabled": true
  }
}
