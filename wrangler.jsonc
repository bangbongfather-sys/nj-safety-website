{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nj-safety-website",
  "compatibility_date": "2025-04-01",
  // Kept from when /api/contact composed MIME messages with mimetext.
  // Nothing in the Worker needs node built-ins today, but the flag is
  // harmless and dropping it changes runtime resolution behaviour, so
  // it stays until there's a reason to touch it.
  "compatibility_flags": ["nodejs_compat"],

  // Worker entry — handles /api/admin/upload-image, falls back to static
  // assets for everything else. Until we ship the upload feature this
  // Worker is essentially a passthrough.
  "main": "worker/index.ts",

  // Live domain. Declared here rather than only in the dashboard so the
  // binding is version-controlled and a fresh deploy re-asserts it.
  // `custom_domain` makes Cloudflare manage the DNS record and issue the
  // certificate; njfashion.co.kr's nameservers point at Cloudflare
  // (registrar is still 가비아). www and m are attached so the Worker can
  // 301 them onto the apex — see CANONICAL_HOST in worker/index.ts.
  // The nj-safety-website.njsafety91.workers.dev address stays live
  // alongside these as an admin fallback.
  "routes": [
    { "pattern": "njfashion.co.kr", "custom_domain": true },
    { "pattern": "www.njfashion.co.kr", "custom_domain": true },
    { "pattern": "m.njfashion.co.kr", "custom_domain": true }
  ],

  // MUST stay true. Declaring `routes` makes wrangler disable the
  // workers.dev address by default, which silently killed the admin's
  // fallback URL the first time this config shipped. That address is the
  // only way in if njfashion.co.kr ever has DNS or certificate trouble.
  "workers_dev": true,

  // Static export (`out/`) served via the ASSETS binding. The Worker
  // delegates to env.ASSETS.fetch(req) for any path it doesn't handle.
  // `not_found_handling` is deliberately "none".
  //
  // With "404-page" Cloudflare's asset layer answered browser NAVIGATION
  // requests for a missing path itself — the Worker never ran, so every
  // legacy /pages/* redirect 404'd in a real browser while curl and fetch
  // (non-navigation requests, which do fall through) got the 301. That
  // mismatch is why the old Naver sitelinks looked broken to visitors but
  // fine to every command-line check.
  //
  // "none" sends every asset miss to the Worker instead, which runs the
  // legacy redirects and serves the styled 404 page itself when nothing
  // matches. Asset HITS still bypass the Worker, so normal page views
  // stay off the Workers request quota.
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  // 관리자 계정 저장소. 예전에는 ADMIN_USERS 시크릿에 JSON 을 넣어
  // 뒀는데, 계정 하나 고치는 데도 터미널이 필요했다. D1 로 옮겨서
  // 관리자 페이지 안에서 직원 추가·비밀번호 변경이 되게 한다.
  //
  // 스키마: worker/schema/admin.sql
  //   npx wrangler d1 execute nj-admin --remote --file worker/schema/admin.sql
  //
  // 사이트 내용(공지·제품·자료실)은 여전히 GitHub 저장소에 커밋된다.
  // 이 데이터베이스에는 로그인 정보만 들어간다.
  "d1_databases": [
    {
      "binding": "ADMIN_DB",
      "database_name": "nj-admin",
      "database_id": "01dd751b-281b-41ea-99b8-3340fae5c79e"
    }
  ],

  // R2 bucket for admin-uploaded images. Bucket MUST be created in the
  // Cloudflare dashboard first (Workers & Pages → R2 → Create bucket
  // → name: `nj-images`) and have Public Access enabled. Until then
  // upload requests will fail at runtime but the rest of the site
  // (static pages, text edits) keeps working.
  "r2_buckets": [
    {
      "binding": "IMAGES_R2",
      "bucket_name": "nj-images"
    }
  ],

  // 문의 알림 메일 — 설정하면 켜지고, 안 하면 조용히 꺼져 있다.
  //
  // Submissions are stored in R2 under `inquiries/` and read from
  // /admin/inquiries; that inbox stays the source of truth. On top of
  // it the Worker sends a heads-up mail through Resend's HTTP API so
  // the operator doesn't have to poll the inbox.
  //
  // Cloudflare's own send_email binding is still NOT used: it needs
  // Email Routing enabled on the zone, which repoints njfashion.co.kr's
  // MX records at Cloudflare and would break any mailbox hosted on that
  // domain elsewhere. Resend needs no MX change.
  //
  // Setup (one-time, dashboard → Workers & Pages → nj-safety-website
  // → Settings → Variables and Secrets):
  //   RESEND_API_KEY  (Secret)   — from resend.com. Absent ⇒ no mail,
  //                                everything else unchanged.
  //   CONTACT_TO      (optional) — defaults to njsafety91@naver.com.
  //   RESEND_FROM     (optional) — defaults to Resend's sandbox sender,
  //                                which only delivers to the address
  //                                the Resend account was registered
  //                                with. Once njfashion.co.kr is
  //                                verified in Resend, set this to e.g.
  //                                "NJ SAFETY <noreply@njfashion.co.kr>"
  //                                for reliable delivery to Naver.

  // Public-facing R2 URL. After the bucket's Public Access is enabled,
  // copy the `https://pub-<hash>.r2.dev` URL from the bucket Settings
  // and replace the placeholder below (or set it via dashboard
  // Environment Variables instead — dashboard wins over wrangler.jsonc).
  "vars": {
    "R2_PUBLIC_BASE": "https://pub-586a8dd3a5484370b45c7ace72da8dc4.r2.dev",
    "ADMIN_GH_LOGIN": "bangbongfather-sys"
  },

  "observability": {
    "enabled": true
  }
}
